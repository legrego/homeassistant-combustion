    "options": {
        "step": {
            "init": {
                "description": "Read cooking predictions and SafeCook food safety over Bluetooth. Requires an adapter or proxy that supports connections. When a MeatNet repeater (Booster, Display, Giant Grill Gauge, or Engine) is in range, one connection to it covers every probe; otherwise each probe is connected directly, using one of its three connection slots. Cooking targets and SafeCook programs can then be set from Home Assistant.",
                "data": {
                    "enable_predictions": "Enable cooking predictions and SafeCook"
                }
            }
        }
    },
    "services": {
        "configure_safecook": {
            "name": "Configure SafeCook",
