        "step": {
            "confirm": {
                "description": "Do you want to set up {name}? Every Combustion Predictive Thermometer and Giant Grill Gauge in Bluetooth range will be added, whether heard directly or through a MeatNet repeater."
            }
        },
        "abort": {
            "already_configured": "Combustion is already set up.",
            "not_supported": "This Combustion device is not supported."
        }
    },
    "entity": {
