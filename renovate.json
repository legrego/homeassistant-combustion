{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "pytest-homeassistant-custom-component is built for one Home Assistant release. Bump both together, and only on request from the Dependency Dashboard.",
      "matchPackageNames": [
        "homeassistant",
        "pytest-homeassistant-custom-component"
      ],
      "groupName": "Home Assistant",
      "dependencyDashboardApproval": true
    },
    {
      "description": "These test dependencies must match the pinned Home Assistant integration manifests. Update them with Home Assistant.",
      "matchPackageNames": [
        "aiousbwatcher",
        "bleak",
        "bleak-retry-connector",
        "bluetooth-adapters",
        "bluetooth-auto-recovery",
        "bluetooth-data-tools",
        "dbus-fast",
        "habluetooth",
        "serialx"
      ],
      "enabled": false
    },
    {
      "description": "Keep Python on 3.14; coordinate minor upgrades with Home Assistant.",
      "matchDatasources": ["python-version"],
      "allowedVersions": ">=3.14,<3.15"
    },
    {
      "description": "Keep CI and the development container on Python 3.14.",
      "matchPackageNames": [
        "actions/python-versions",
        "mcr.microsoft.com/devcontainers/python"
      ],
      "allowedVersions": "/^3\\.14(?:[.-]|$)/"
    }
  ]
}
